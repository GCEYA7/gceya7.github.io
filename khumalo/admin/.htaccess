# Khumalo Construction - Admin Panel .htaccess
RewriteEngine On

# Require authentication for admin panel
AuthType Basic
AuthName "Khumalo Construction Admin"
AuthUserFile /home/daytona/project/admin/.htpasswd
Require valid-user

# Allow access to these files without auth (for frontend)
<FilesMatch "^(login\.php|logout\.php|common\.php)$">
    Satisfy Any
    Allow from all
</FilesMatch>

# Security: Prevent access to sensitive files
<FilesMatch "\.(json|php|log|git)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Allow access to content.json for the frontend
<Files "content.json">
    Order Allow,Deny
    Allow from all
</Files>

# PHP settings for uploads
<IfModule mod_php.c>
    php_value upload_max_filesize 50M
    php_value post_max_size 50M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>